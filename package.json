{
  "name": "cbl-power-plant",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:migrate": "npm --prefix backend run migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:setup": "npm --prefix backend run db:setup",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2"
  }
}
