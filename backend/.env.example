# Application
NODE_ENV=development
PORT=5000
APP_NAME=CBL HSE Management System
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cbl_db
DB_USER=cbl_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Default master data used only when an empty database is seeded
DEFAULT_PLANT_ID=5126923e-b77f-4eb6-8b98-d5fc9db8d71b
DEFAULT_PLANT_NAME=CBL LU Sukkur Plant
DEFAULT_PLANT_CODE=CBL-LU-SUKKUR
DEFAULT_PLANT_LOCATION=Sukkur, Sindh

# JWT application sessions (use independently generated random secrets)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_VERIFY_SECRET=replace-with-a-long-random-verification-secret
JWT_VERIFY_EXPIRY=24h
JWT_RESET_SECRET=replace-with-a-long-random-reset-secret
JWT_RESET_EXPIRY=1h
ENCRYPTION_KEY=change-this-32-char-key-12345678

# Microsoft Entra ID / MSAL
MSAL_CLIENT_ID=replace-with-application-client-id
MSAL_TENANT_ID=replace-with-directory-tenant-id

# Optional first application administrator. Omit to provision users through
# the Administration UI/Entra onboarding. Password is never stored in Git.
SEED_ADMIN_EMAIL=
SEED_ADMIN_FIRST_NAME=Deployment
SEED_ADMIN_LAST_NAME=Administrator
SEED_ADMIN_PASSWORD=

# Redis (optional cache/queue; the API degrades gracefully when unavailable)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# File storage
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Email (optional)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM_NAME=CBL HSE
MAIL_FROM_EMAIL=
SENDGRID_API_KEY=

# Operational settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info
LOG_DIR=logs

# Development-only safeguards. All are ignored/refused in production.
ALLOW_UNVERIFIED_HAZARD_EMPLOYEE=false
BYPASS_HAZARD_VALIDATION=false
PREVIEW_AUTH=false
PREVIEW_USER_ID=
