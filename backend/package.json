{
  "name": "cbl-backend",
  "version": "1.0.0",
  "description": "Production-ready Node.js/Express/MySQL REST API backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:locations": "node scripts/migrate-locations.js",
    "migrate:administrator-rbac": "node scripts/migrate-administrator-rbac.js",
    "seed": "node scripts/seed.js",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:fresh": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate && node scripts/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPattern=tests/unit --runInBand --forceExit",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPattern=tests/integration --runInBand --forceExit",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand --forceExit",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "generate:key": "node scripts/generateKey.js",
    "docs": "echo 'Swagger docs served at /api/docs when app is running'"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "jwt",
    "rest-api",
    "rbac"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@sendgrid/mail": "^8.1.3",
    "aws-sdk": "^2.1693.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "rate-limit-redis": "^4.2.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.2",
    "sharp": "^0.33.4",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.1",
    "uuid": "^14.0.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.7",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "sinon": "^18.0.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
