# ─── Dependencies ───────────────────────────
node_modules/
.npm
.turbo/

# ─── Environment ────────────────────────────
.env
.env.*
!.env.example
!**/.env.example
docker-compose.env

# ─── Logs ───────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database snapshots and credentials must not be committed. Historical/demo
# data is loaded through reviewed import scripts from separately supplied files.
*.sql
*.dump
*.bak
*.pem
*.pfx
*.key

# ─── Build ──────────────────────────────────
dist/
build/

# ─── Uploads / Storage ──────────────────────
uploads/*
!uploads/.gitkeep
storage/*
!storage/avatars/.gitkeep
!storage/documents/.gitkeep
cache/*
!cache/.gitkeep

# ─── OS ─────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Test Coverage ──────────────────────────
coverage/
.nyc_output

# ─── Misc ───────────────────────────────────
*.pid
*.seed
*.pid.lock
node_modules
